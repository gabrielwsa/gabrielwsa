---
import "@fontsource-variable/onest"

import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"
import { ViewTransitions } from "astro:transitions"
import { alternatePath, getLangFromUrl } from "@/i18n/utils"
import { languages, type Lang } from "@/i18n/ui"

interface Props {
  title: string
  description: string
}

const { description, title } = Astro.props
const lang = getLangFromUrl(Astro.url)
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    {
      (Object.keys(languages) as Lang[]).map((code) => (
        <link
          rel="alternate"
          hreflang={code}
          href={new URL(alternatePath(Astro.url, code), Astro.site)}
        />
      ))
    }
    <title>{title}</title>
    <ViewTransitions />
  </head>

  <body class="min-h-screen bg-[var(--page-bg)] text-[var(--text-primary)] antialiased">
    <Header />
    <div class="relative flex-1 pb-16">
      <slot />
    </div>
    <Footer />
    <style is:global>
      :root {
        color-scheme: light;
        --page-bg: #fbfaf8;
        --surface: #ffffff;
        --surface-border: rgba(15, 23, 42, 0.08);
        --text-primary: #0f172a;
        --text-secondary: #475569;
        --text-muted: #64748b;
        --accent-strong: #0f766e;
        --accent-soft: rgba(15, 118, 110, 0.08);
        --accent-border: rgba(15, 118, 110, 0.2);
      }

      html.dark {
        color-scheme: dark;
        --page-bg: #0b1120;
        --surface: #111a2c;
        --surface-border: rgba(148, 163, 184, 0.14);
        --text-primary: #f1f5f9;
        --text-secondary: #cbd5e1;
        --text-muted: #94a3b8;
        --accent-strong: #5eead4;
        --accent-soft: rgba(94, 234, 212, 0.1);
        --accent-border: rgba(94, 234, 212, 0.22);
      }

      html {
        font-family: "Onest Variable", system-ui, sans-serif;
        scroll-behavior: smooth;
        background: var(--page-bg);
      }

      body {
        margin: 0;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        background: var(--page-bg);
        color: var(--text-primary);
      }

      * {
        box-sizing: border-box;
      }

      ::selection {
        background: var(--accent-soft);
        color: var(--text-primary);
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
      }

      .panel-surface {
        background: var(--surface);
        border: 1px solid var(--surface-border);
      }
    </style>
  </body>
</html>
