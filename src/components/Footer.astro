---
import { profile } from "@/data/portfolio"
import { getLangFromUrl, localizePath, useTranslations } from "@/i18n/utils"

const currentYear = new Date().getFullYear()
const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const links = [
  { href: localizePath("/cv?print=0", lang), label: t("hero.cv"), external: false },
  { href: profile.github, label: "GitHub", external: true },
  { href: profile.linkedin, label: "LinkedIn", external: true },
]
---

<footer class="border-t-2 border-[var(--rule)]">
  <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6 lg:px-8">
    <p class="mono text-[0.65rem] uppercase tracking-[0.25em] text-[var(--text-muted)]">
      {t("footer.kicker")}
    </p>
    <a
      href={`mailto:${profile.email}`}
      class="mt-4 block text-3xl font-semibold tracking-[-0.03em] text-[var(--text-primary)] underline decoration-[var(--accent)] decoration-2 underline-offset-8 transition-colors hover:text-[var(--accent)] sm:text-5xl"
    >
      {profile.email}
    </a>

    <div
      class="mono mt-12 flex flex-col gap-4 border-t border-[var(--rule-soft)] pt-6 text-[0.7rem] uppercase tracking-[0.15em] text-[var(--text-muted)] sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {currentYear} {profile.name} — {t("footer.rights")}</p>

      <div class="flex flex-wrap gap-6">
        {
          links.map((link) => (
            <a
              href={link.href}
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noopener noreferrer" : undefined}
              class="transition-colors hover:text-[var(--accent)]"
            >
              {link.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>
