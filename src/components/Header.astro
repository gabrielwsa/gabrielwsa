---
import ThemeToggle from "./ThemeToggle.astro"
import LanguageToggle from "./LanguageToggle.astro"
import { profile } from "@/data/portfolio"
import { getLangFromUrl, sectionHref, sectionId, useTranslations } from "@/i18n/utils"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const navItems = [
  { title: t("nav.home"), label: sectionId("home", lang), url: sectionHref("home", lang) },
  {
    title: t("nav.experience"),
    label: sectionId("experience", lang),
    url: sectionHref("experience", lang),
  },
  {
    title: t("nav.projects"),
    label: sectionId("projects", lang),
    url: sectionHref("projects", lang),
  },
  {
    title: t("nav.certifications"),
    label: sectionId("certifications", lang),
    url: sectionHref("certifications", lang),
  },
  { title: t("nav.about"), label: sectionId("about", lang), url: sectionHref("about", lang) },
  { title: t("nav.contact"), label: "contact", url: `mailto:${profile.email}` },
]
---

<header
  class="sticky top-0 z-50 border-b-2 border-[var(--rule)] bg-[var(--page-bg)]/90 backdrop-blur"
>
  <nav
    class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8"
  >
    <a
      href={sectionHref("home", lang)}
      class="group flex items-baseline gap-2"
      aria-label={t("nav.toHome")}
    >
      <span class="mono text-[0.7rem] uppercase tracking-[0.3em] text-[var(--accent)]">GWS</span>
      <span
        class="text-sm font-semibold uppercase tracking-tight text-[var(--text-primary)] transition-colors group-hover:text-[var(--accent)]"
      >
        Gabriel W. Silva
      </span>
    </a>

    <div class="hidden items-center md:flex">
      {
        navItems.map((link) => (
          <a
            class="nav-link mono px-3 py-2 text-[0.7rem] uppercase tracking-[0.15em] text-[var(--text-muted)] transition-colors hover:text-[var(--text-primary)]"
            data-nav-label={link.label}
            href={link.url}
          >
            {link.title}
          </a>
        ))
      }
    </div>

    <div class="flex items-center gap-2">
      <LanguageToggle />
      <ThemeToggle />
      <button
        id="mobile-menu-button"
        class="inline-flex h-9 w-9 items-center justify-center border-2 border-[var(--rule)] text-[var(--text-primary)] transition-colors hover:bg-[var(--accent)] hover:text-[var(--accent-contrast)] md:hidden"
        aria-label={t("nav.openMenu")}
        aria-expanded="false"
        aria-controls="nav-menu"
      >
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="square" stroke-width="2" d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </nav>

  <div id="nav-menu" class="nav-menu border-t-2 border-[var(--rule)] md:hidden">
    <div class="mx-auto flex max-w-5xl flex-col px-4 sm:px-6">
      {
        navItems.map((link) => (
          <a
            class="nav-link mono border-b border-[var(--rule-soft)] py-3 text-[0.7rem] uppercase tracking-[0.2em] text-[var(--text-secondary)] transition-colors last:border-b-0 hover:text-[var(--accent)]"
            data-nav-label={link.label}
            href={link.url}
          >
            {link.title}
          </a>
        ))
      }
    </div>
  </div>
</header>

<script>
  type HeaderWindow = Window & typeof globalThis & {
    __gabrielHeaderCleanup?: () => void
  }

  const headerWindow = window as HeaderWindow

  const setupHeader = () => {
    headerWindow.__gabrielHeaderCleanup?.()

    const sections = [...document.querySelectorAll<HTMLElement>("main section[id]")]
    const navLinks = [...document.querySelectorAll<HTMLAnchorElement>(".nav-link")]
    const mobileMenuButton = document.getElementById("mobile-menu-button")
    const navMenu = document.getElementById("nav-menu")

    if (!mobileMenuButton || !navMenu) {
      return
    }

    const setMenuOpen = (isOpen: boolean) => {
      navMenu.classList.toggle("is-open", isOpen)
      mobileMenuButton.setAttribute("aria-expanded", String(isOpen))
    }

    const setActiveLink = (id: string) => {
      navLinks.forEach((link) => {
        link.dataset.active = link.getAttribute("data-nav-label") === id ? "true" : "false"
      })
    }

    const onButtonClick = () => {
      setMenuOpen(!navMenu.classList.contains("is-open"))
    }

    const onResize = () => {
      if (window.innerWidth >= 768) {
        setMenuOpen(false)
      }
    }

    mobileMenuButton.addEventListener("click", onButtonClick)
    window.addEventListener("resize", onResize)
    const linkCleanup = navLinks.map((link) => {
      const onLinkClick = () => setMenuOpen(false)
      link.addEventListener("click", onLinkClick)
      return () => link.removeEventListener("click", onLinkClick)
    })

    let observer: IntersectionObserver | undefined

    if (sections.length > 0) {
      observer = new IntersectionObserver(
        (entries) => {
          const visibleSection = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0]

          if (visibleSection) {
            setActiveLink(visibleSection.target.id)
          }
        },
        {
          rootMargin: "-20% 0px -55% 0px",
          threshold: [0.2, 0.35, 0.6],
        }
      )

      const activeObserver = observer
      sections.forEach((section) => activeObserver.observe(section))
      setActiveLink(sections[0].id)
    }

    headerWindow.__gabrielHeaderCleanup = () => {
      mobileMenuButton.removeEventListener("click", onButtonClick)
      window.removeEventListener("resize", onResize)
      linkCleanup.forEach((cleanup) => cleanup())
      observer?.disconnect()
    }
  }

  setupHeader()
  document.addEventListener("astro:page-load", setupHeader)
</script>

<style>
  .nav-menu {
    display: none;
  }

  .nav-menu.is-open {
    display: block;
  }

  .nav-link[data-active="true"] {
    color: var(--text-primary);
    box-shadow: inset 0 -3px 0 var(--accent);
  }
</style>
