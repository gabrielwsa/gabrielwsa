---
import { getCollection } from "astro:content"
import { getContent, profile, skills } from "@/data/portfolio"
import { getLangFromUrl, localizePath, useTranslations } from "@/i18n/utils"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const c = getContent(lang)
const certifications = (await getCollection("certifications")).sort((a, b) =>
  a.data.title.localeCompare(b.data.title)
)
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={t("cv.description")} />
    <title>{t("cv.title")} | {profile.name}</title>
  </head>
  <body>
    <main class="cv-page">
      <nav class="cv-actions" aria-label={t("cv.title")}>
        <a href={localizePath("/", lang)}>{t("cv.back")}</a>
        <button id="print-btn" type="button">{t("cv.save")}</button>
      </nav>

      <article class="cv-paper">
        <header>
          <h1>{profile.name}</h1>
          <p class="cv-role">{c.role}</p>
          <div class="cv-contact">
            <p>{profile.location}</p>
            <p>
              <a href={`mailto:${profile.email}`}>{profile.email}</a>
              <span aria-hidden="true"> · </span>
              <a href={`tel:${profile.phoneHref}`}>{profile.phone}</a>
            </p>
            <p>
              <a href={profile.linkedin} target="_blank" rel="noopener noreferrer">{profile.linkedin.replace("https://", "")}</a>
              <span aria-hidden="true"> · </span>
              <a href={profile.github} target="_blank" rel="noopener noreferrer">{profile.github.replace("https://", "")}</a>
            </p>
          </div>
          <p class="cv-summary">{c.summary}</p>
        </header>

        <section>
          <h2>{t("cv.experience")}</h2>
          {c.experience.map((item) => (
            <article class="cv-entry">
              <div class="cv-entry-heading">
                <h3>{item.title}</h3>
                <span class="cv-date">{item.date}</span>
              </div>
              <p>{item.company}</p>
              {item.description && <p class="cv-description">{item.description}</p>}
            </article>
          ))}
        </section>

        <section>
          <h2>{t("cv.skills")}</h2>
          <p>{skills.join(", ")}</p>
        </section>

        <section>
          <h2>{t("cv.projects")}</h2>
          <article class="cv-entry">
            <h3>TraderBot</h3>
            <a href="https://github.com/gabrielwsa/TraderBot" target="_blank" rel="noopener noreferrer">github.com/gabrielwsa/TraderBot</a>
          </article>
          <article class="cv-entry">
            <h3>ticketera</h3>
            <a href="https://github.com/gabrielwsa/ticketera" target="_blank" rel="noopener noreferrer">github.com/gabrielwsa/ticketera</a>
          </article>
        </section>

        <section>
          <h2>{t("cv.certifications")}</h2>
          <ul class="cv-certifications">
            {certifications.map((certification) => (
              <li>
                {lang === "en" ? (certification.data.titleEn ?? certification.data.title) : certification.data.title}
                {" — "}
                {lang === "en" ? certification.data.hoursEn : certification.data.hours}
              </li>
            ))}
          </ul>
        </section>
      </article>
    </main>

    <style is:global>
      :root { color-scheme: light; }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: #fff;
        color: #111;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 14px;
        line-height: 1.5;
      }
      .cv-page { max-width: 210mm; margin: 0 auto; padding: 24px; }
      .cv-actions { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 32px; }
      a { color: inherit; text-underline-offset: 3px; }
      a:hover { text-decoration: underline; }
      a:focus-visible, button:focus-visible { outline: 2px solid #111; outline-offset: 4px; }
      button { border: 1px solid #999; background: #fff; color: #111; padding: 8px 12px; font: inherit; cursor: pointer; }
      button:hover { background: #f2f2f2; }
      .cv-paper { padding: 12px 24px 32px; }
      h1, h2, h3, p { margin: 0; }
      h1 { font-size: 26px; line-height: 1.2; font-weight: 700; }
      .cv-role { margin-top: 4px; font-size: 16px; }
      .cv-contact { margin-top: 10px; font-size: 12px; overflow-wrap: anywhere; }
      .cv-contact a { text-decoration: none; }
      .cv-contact a:hover { text-decoration: underline; }
      .cv-summary { margin-top: 16px; }
      section { margin-top: 20px; }
      h2 { margin-bottom: 9px; border-bottom: 1px solid #aaa; padding-bottom: 3px; font-size: 15px; font-weight: 700; }
      h3 { font-size: 14px; font-weight: 700; }
      .cv-entry + .cv-entry { margin-top: 14px; }
      .cv-entry-heading { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
      .cv-date { font-size: 12px; white-space: nowrap; }
      .cv-description { margin-top: 5px; }
      .cv-certifications { margin: 0; padding-left: 18px; }
      .cv-certifications li + li { margin-top: 3px; }
      @media (max-width: 540px) {
        .cv-page { padding: 20px 16px; }
        .cv-paper { padding: 0; }
        h1 { font-size: 24px; }
        .cv-entry-heading { display: block; }
      }
      @page { size: A4; margin: 15mm; }
      @media print {
        body { font-size: 10pt; line-height: 1.4; }
        .cv-page { max-width: none; margin: 0; padding: 0; }
        .cv-actions { display: none; }
        .cv-paper { padding: 0; }
        h1 { font-size: 20pt; }
        h2 { font-size: 11pt; break-after: avoid; }
        h3 { font-size: 10pt; }
        .cv-role { font-size: 12pt; }
        .cv-contact, .cv-date { font-size: 9pt; }
        .cv-entry-heading { display: flex; }
        section { margin-top: 14px; }
        header, .cv-entry, li { break-inside: avoid; }
        a { text-decoration: none; }
      }
    </style>

    <script>
      const printButton = document.getElementById("print-btn")
      const triggerPrint = () => window.print()
      printButton?.addEventListener("click", triggerPrint)
      if (new URLSearchParams(window.location.search).get("print") === "1") {
        window.addEventListener("load", () => window.setTimeout(triggerPrint, 250))
      }
    </script>
  </body>
</html>
