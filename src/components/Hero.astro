---
import LinkedInIcon from "@/components/icons/LinkedIn.astro"
import MailIcon from "@/components/icons/Mail.astro"
import GitHubIcon from "@/components/icons/GitHub.astro"
import CVdownload from "@/components/icons/CVdownload.astro"
import { getContent, profile, yearsOfExperience } from "@/data/portfolio"
import { getLangFromUrl, localizePath, sectionHref, useTranslations } from "@/i18n/utils"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const c = getContent(lang)

const stats = [
  { value: `${yearsOfExperience()}+`, label: c.stats[0] },
  { value: `${c.projects.length}+`, label: c.stats[1] },
  { value: `${profile.certificationCount}+`, label: c.stats[2] },
]

const links = [
  { href: profile.github, icon: GitHubIcon, label: "GitHub" },
  { href: profile.linkedin, icon: LinkedInIcon, label: "LinkedIn" },
  { href: `mailto:${profile.email}`, icon: MailIcon, label: t("hero.contact") },
]
---

<div class="flex flex-col gap-12">
  <div class="flex flex-wrap items-center gap-x-5 gap-y-4">
    <!-- Photo sits in a hard frame, offset from a solid accent block behind it. -->
    <div class="relative shrink-0">
      <div class="absolute left-2 top-2 h-16 w-16 bg-[var(--accent)]"></div>
      <img
        class="relative h-16 w-16 border-2 border-[var(--rule)] object-cover grayscale transition-all duration-300 hover:grayscale-0"
        src="/gabriel.jpg"
        alt={profile.name}
        width="64"
        height="64"
      />
    </div>

    <div class="mono flex flex-col gap-1.5 text-[0.7rem] uppercase tracking-[0.2em]">
      <span class="text-[var(--text-muted)]">{c.role}</span>
      <span class="flex items-center gap-2 text-[var(--text-primary)]">
        <span class="inline-block h-2 w-2 animate-pulse bg-[var(--accent)]"></span>
        {t("hero.available")}
      </span>
    </div>
  </div>

  <div>
    <h1
      class="max-w-4xl text-balance text-4xl font-semibold leading-[1.05] tracking-[-0.03em] text-[var(--text-primary)] sm:text-6xl"
    >
      {c.tagline}
    </h1>

    <div class="mt-8 grid gap-x-10 gap-y-5 border-t-2 border-[var(--rule)] pt-6 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
      <p class="text-lg leading-8 text-[var(--text-secondary)]">
        {t("hero.iam")} <strong class="font-semibold text-[var(--text-primary)]">{profile.name}</strong>,
        {c.summary}
      </p>

      <p class="border-l-2 border-[var(--accent)] pl-5 leading-7 text-[var(--text-muted)]">
        {c.heroNote}
      </p>
    </div>
  </div>

  <div class="flex flex-wrap items-center gap-3">
    <a
      href={localizePath("/cv?print=0", lang)}
      class="hard-shift mono inline-flex items-center gap-2 border-2 border-[var(--rule)] bg-[var(--rule)] px-5 py-3 text-[0.7rem] uppercase tracking-[0.2em] text-[var(--page-bg)]"
    >
      <CVdownload class="size-4" />
      {t("hero.cv")}
    </a>
    <a
      href={sectionHref("projects", lang)}
      class="hard-shift mono inline-flex items-center gap-2 border-2 border-[var(--rule)] px-5 py-3 text-[0.7rem] uppercase tracking-[0.2em] text-[var(--text-primary)]"
    >
      {t("hero.viewProjects")}
      <span aria-hidden="true">↓</span>
    </a>

    <div class="flex items-center gap-2 sm:ml-2">
      {
        links.map((link) => (
          <a
            href={link.href}
            target={link.href.startsWith("http") ? "_blank" : undefined}
            rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
            aria-label={link.label}
            class="inline-flex h-11 w-11 items-center justify-center border-2 border-[var(--rule-soft)] text-[var(--text-muted)] transition-colors hover:border-[var(--rule)] hover:bg-[var(--accent)] hover:text-[var(--accent-contrast)]"
          >
            <link.icon class="size-5" />
          </a>
        ))
      }
    </div>
  </div>

  <dl class="grid border-2 border-[var(--rule)] sm:grid-cols-3">
    {
      stats.map((stat, index) => (
        <div
          class:list={[
            "px-5 py-6",
            index > 0 && "border-t-2 border-[var(--rule)] sm:border-l-2 sm:border-t-0",
          ]}
        >
          <dt class="text-4xl font-semibold tracking-[-0.04em] text-[var(--text-primary)]">
            {stat.value}
          </dt>
          <dd class="mono mt-2 text-[0.65rem] uppercase tracking-[0.2em] text-[var(--text-muted)]">
            {stat.label}
          </dd>
        </div>
      ))
    }
  </dl>
</div>
