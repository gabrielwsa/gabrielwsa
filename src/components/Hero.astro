---
import LinkedInIcon from "@/components/icons/LinkedIn.astro"
import MailIcon from "@/components/icons/Mail.astro"
import GitHubIcon from "@/components/icons/GitHub.astro"
import CVdownload from "@/components/icons/CVdownload.astro"
import { getContent, profile } from "@/data/portfolio"
import { getLangFromUrl, localizePath, sectionHref, useTranslations } from "@/i18n/utils"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const c = getContent(lang)

const stats = [
  { value: String(c.experience.length), label: c.stats[0] },
  { value: `${c.projects.length}+`, label: c.stats[1] },
  { value: `${profile.certificationCount}+`, label: c.stats[2] },
]

const links = [
  { href: profile.github, icon: GitHubIcon, label: "GitHub" },
  { href: profile.linkedin, icon: LinkedInIcon, label: "LinkedIn" },
  { href: `mailto:${profile.email}`, icon: MailIcon, label: t("hero.contact") },
]
---

<div class="flex flex-col gap-10">
  <div class="flex items-center gap-4">
    <img
      class="h-14 w-14 rounded-full object-cover"
      src="/gabriel.jpg"
      alt={profile.name}
      width="56"
      height="56"
    />
    <div>
      <p class="font-medium text-[var(--text-primary)]">Gabriel W. Silva</p>
      <p class="flex items-center gap-2 text-sm text-[var(--text-muted)]">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
        {t("hero.available")}
      </p>
    </div>
  </div>

  <div>
    <h1
      class="max-w-3xl text-balance text-4xl font-semibold tracking-tight text-[var(--text-primary)] sm:text-5xl"
    >
      {c.tagline}
    </h1>

    <p class="mt-6 max-w-2xl text-lg leading-8 text-[var(--text-secondary)]">
      {t("hero.iam")} <strong class="font-medium text-[var(--text-primary)]">{profile.name}</strong>,
      {c.summary}
    </p>

    <p class="mt-4 max-w-2xl leading-7 text-[var(--text-muted)]">
      {c.heroNote}
    </p>
  </div>

  <div class="flex flex-wrap items-center gap-3">
    <a
      href={localizePath("/cv?print=0", lang)}
      class="inline-flex items-center gap-2 rounded-full bg-[var(--text-primary)] px-4 py-2.5 text-sm font-medium text-[var(--page-bg)] transition-opacity hover:opacity-90"
    >
      <CVdownload class="size-4" />
      {t("hero.cv")}
    </a>
    <a
      href={sectionHref("projects", lang)}
      class="inline-flex items-center gap-2 rounded-full border border-[var(--surface-border)] px-4 py-2.5 text-sm font-medium text-[var(--text-primary)] transition-colors hover:border-[var(--accent-border)] hover:text-[var(--accent-strong)]"
    >
      {t("hero.viewProjects")}
    </a>

    <div class="flex items-center gap-1 sm:ml-2">
      {
        links.map((link) => (
          <a
            href={link.href}
            target={link.href.startsWith("http") ? "_blank" : undefined}
            rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
            aria-label={link.label}
            class="inline-flex h-10 w-10 items-center justify-center rounded-full text-[var(--text-muted)] transition-colors hover:bg-[var(--accent-soft)] hover:text-[var(--accent-strong)]"
          >
            <link.icon class="size-5" />
          </a>
        ))
      }
    </div>
  </div>

  <dl class="grid gap-6 border-t border-[var(--surface-border)] pt-8 sm:grid-cols-3">
    {
      stats.map((stat) => (
        <div>
          <dt class="text-3xl font-semibold tracking-tight text-[var(--text-primary)]">
            {stat.value}
          </dt>
          <dd class="mt-1 text-sm text-[var(--text-muted)]">{stat.label}</dd>
        </div>
      ))
    }
  </dl>
</div>
