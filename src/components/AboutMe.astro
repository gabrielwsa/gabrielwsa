---
import { getContent } from "@/data/portfolio"
import { getLangFromUrl } from "@/i18n/utils"

const lang = getLangFromUrl(Astro.url)
const c = getContent(lang)
---

<div class="grid gap-12 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)]">
  <div class="space-y-5">
    {
      c.aboutParagraphs.map((paragraph) => (
        <p class="text-lg leading-8 text-[var(--text-secondary)]">
          {paragraph.text}
          <strong class="font-medium text-[var(--text-primary)]">{paragraph.strong}</strong>
          {paragraph.rest}
        </p>
      ))
    }
  </div>

  <ul class="space-y-3">
    {
      c.strengths.map((strength) => (
        <li class="flex gap-3 text-[var(--text-secondary)]">
          <span
            aria-hidden="true"
            class="mt-2.5 inline-block h-1 w-1 shrink-0 rounded-full bg-[var(--accent-strong)]"
          />
          <span class="leading-7">{strength}</span>
        </li>
      ))
    }
  </ul>
</div>
