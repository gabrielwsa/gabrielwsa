---
import GitHub from "./icons/GitHub.astro"
import Link from "./icons/Link.astro"
import React from "./icons/React.astro"
import { getContent } from "@/data/portfolio"
import { getLangFromUrl, useTranslations } from "@/i18n/utils"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const c = getContent(lang)

const tagMap = {
  React: { name: "React", icon: React },
}
---

<div class="grid gap-8 sm:grid-cols-2">
  {
    c.projects.map(({ image, title, eyebrow, description, tags, link, github }, index) => (
      <article class="hard-shift group flex flex-col border-2 border-[var(--rule)] bg-[var(--surface)]">
        <a
          href={link}
          target="_blank"
          rel="noopener noreferrer"
          class="relative block overflow-hidden border-b-2 border-[var(--rule)]"
        >
          <img
            alt={`${t("projects.preview")} ${title}`}
            class="aspect-[16/10] w-full object-cover object-top"
            loading="lazy"
            src={image}
          />
          <span class="mono absolute left-0 top-0 bg-[var(--rule)] px-2 py-1 text-[0.65rem] tracking-[0.2em] text-[var(--page-bg)]">
            {String(index + 1).padStart(2, "0")}
          </span>
        </a>

        <div class="flex flex-1 flex-col p-6">
          <p class="mono text-[0.65rem] uppercase tracking-[0.2em] text-[var(--text-muted)]">
            {eyebrow}
          </p>
          <h3 class="mt-3 text-xl font-semibold tracking-[-0.02em] text-[var(--text-primary)]">
            {title}
          </h3>
          <p class="mt-3 flex-1 leading-7 text-[var(--text-secondary)]">{description}</p>

          <div class="mt-5 flex flex-wrap items-center gap-2">
            {tags.map((tagName) => {
              const tag = tagMap[tagName]

              return (
                <span class="mono inline-flex items-center gap-1.5 border border-[var(--rule-soft)] px-2 py-1 text-[0.65rem] uppercase tracking-[0.15em] text-[var(--text-secondary)]">
                  <tag.icon class="size-3.5" />
                  {tag.name}
                </span>
              )
            })}
          </div>

          <div class="mono mt-6 flex flex-wrap gap-5 border-t border-[var(--rule-soft)] pt-4 text-[0.7rem] uppercase tracking-[0.15em]">
            {github && (
              <a
                href={github}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-[var(--text-muted)] transition-colors hover:text-[var(--text-primary)]"
              >
                <GitHub class="size-4" />
                GitHub
              </a>
            )}
            {link && (
              <a
                href={link}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-[var(--accent)] transition-opacity hover:opacity-70"
              >
                <Link class="size-4" />
                {t("projects.website")}
              </a>
            )}
          </div>
        </div>
      </article>
    ))
  }
</div>
