---
import GitHub from "./icons/GitHub.astro"
import Link from "./icons/Link.astro"
import React from "./icons/React.astro"
import { getContent } from "@/data/portfolio"
import { getLangFromUrl, useTranslations } from "@/i18n/utils"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const c = getContent(lang)

const tagMap = {
  React: { name: "React", icon: React },
}
---

<div class="grid gap-10 sm:grid-cols-2">
  {
    c.projects.map(({ image, title, eyebrow, description, tags, link, github }) => (
      <article class="group flex flex-col">
        <a
          href={link}
          target="_blank"
          rel="noopener noreferrer"
          class="overflow-hidden rounded-xl border border-[var(--surface-border)]"
        >
          <img
            alt={`${t("projects.preview")} ${title}`}
            class="aspect-[16/10] w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
            loading="lazy"
            src={image}
          />
        </a>

        <div class="mt-5 flex flex-1 flex-col">
          <p class="text-xs font-medium uppercase tracking-wider text-[var(--text-muted)]">
            {eyebrow}
          </p>
          <h3 class="mt-2 text-xl font-semibold tracking-tight text-[var(--text-primary)]">
            {title}
          </h3>
          <p class="mt-3 flex-1 leading-7 text-[var(--text-secondary)]">{description}</p>

          <div class="mt-5 flex flex-wrap items-center gap-2">
            {tags.map((tagName) => {
              const tag = tagMap[tagName]

              return (
                <span class="inline-flex items-center gap-1.5 rounded-full bg-[var(--accent-soft)] px-2.5 py-1 text-xs font-medium text-[var(--accent-strong)]">
                  <tag.icon class="size-3.5" />
                  {tag.name}
                </span>
              )
            })}
          </div>

          <div class="mt-5 flex flex-wrap gap-4 text-sm font-medium">
            {github && (
              <a
                href={github}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-[var(--text-muted)] transition-colors hover:text-[var(--text-primary)]"
              >
                <GitHub class="size-4" />
                GitHub
              </a>
            )}
            {link && (
              <a
                href={link}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-[var(--accent-strong)] transition-opacity hover:opacity-80"
              >
                <Link class="size-4" />
                {t("projects.website")}
              </a>
            )}
          </div>
        </div>
      </article>
    ))
  }
</div>
