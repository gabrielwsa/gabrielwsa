---
import { getContent } from "@/data/portfolio"
import { getLangFromUrl } from "@/i18n/utils"

const lang = getLangFromUrl(Astro.url)
const c = getContent(lang)
---

<ol class="border-l-2 border-[var(--rule-soft)] pl-6 sm:pl-10">
  {
    c.experience.map((item, index) => (
      <li class="relative pb-12 last:pb-0">
        {/* Square marker straddling the timeline rule. */}
        <span
          aria-hidden="true"
          class:list={[
            "absolute -left-[calc(1.5rem+5px)] top-2 h-2 w-2 border-2 border-[var(--rule)] sm:-left-[calc(2.5rem+5px)]",
            index === 0 ? "bg-[var(--accent)]" : "bg-[var(--page-bg)]",
          ]}
        />
        <time class="mono block text-[0.7rem] uppercase tracking-[0.2em] text-[var(--text-muted)]">
          {item.date}
        </time>
        <h3 class="mt-3 text-2xl font-semibold tracking-[-0.02em] text-[var(--text-primary)]">
          {item.title}
        </h3>
        <p class="mono mt-2 text-[0.75rem] uppercase tracking-[0.15em] text-[var(--accent)]">
          {item.company}
        </p>
        {item.description && (
          <p class="mt-4 max-w-2xl leading-7 text-[var(--text-secondary)]">{item.description}</p>
        )}
      </li>
    ))
  }
</ol>
