---
import { getContent } from "@/data/portfolio"
import { getLangFromUrl } from "@/i18n/utils"

const lang = getLangFromUrl(Astro.url)
const c = getContent(lang)
---

<ol class="divide-y divide-[var(--surface-border)]">
  {
    c.experience.map((item) => (
      <li class="grid gap-2 py-8 first:pt-0 last:pb-0 sm:grid-cols-[10rem_minmax(0,1fr)] sm:gap-8">
        <time class="text-sm leading-7 text-[var(--text-muted)]">{item.date}</time>
        <div>
          <h3 class="text-xl font-semibold tracking-tight text-[var(--text-primary)]">
            {item.title}
          </h3>
          <p class="mt-1 text-sm font-medium text-[var(--accent-strong)]">{item.company}</p>
          {item.description && (
            <p class="mt-4 leading-7 text-[var(--text-secondary)]">{item.description}</p>
          )}
        </div>
      </li>
    ))
  }
</ol>
