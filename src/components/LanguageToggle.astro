---
import { alternatePath, getLangFromUrl } from "@/i18n/utils"
import { languages, type Lang } from "@/i18n/ui"

const lang = getLangFromUrl(Astro.url)
const codes = Object.keys(languages) as Lang[]
---

<div
  class="mono inline-flex items-center border-2 border-[var(--rule)] text-[0.65rem] font-medium"
>
  {
    codes.map((code) => (
      <a
        href={alternatePath(Astro.url, code)}
        hreflang={code}
        aria-label={languages[code]}
        aria-current={code === lang ? "true" : undefined}
        class:list={[
          "px-2.5 py-1.5 uppercase tracking-[0.1em] transition-colors",
          code === lang
            ? "bg-[var(--accent)] text-[var(--accent-contrast)]"
            : "text-[var(--text-muted)] hover:text-[var(--text-primary)]",
        ]}
      >
        {code}
      </a>
    ))
  }
</div>
