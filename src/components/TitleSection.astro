---
interface Props {
  class?: string
  /** Two-digit marker printed at the end of the rule, e.g. "02". */
  index?: string
}

const { class: className = "", index } = Astro.props
---

<div class={`flex items-end justify-between gap-6 border-b-2 border-[var(--rule)] pb-4 ${className}`}>
  <h2
    class="flex items-center gap-3 text-2xl font-semibold uppercase tracking-[-0.02em] text-[var(--text-primary)] sm:text-3xl [&>svg]:size-5 [&>svg]:shrink-0 [&>svg]:text-[var(--accent)]"
  >
    <slot />
  </h2>
  {
    index && (
      <span class="mono shrink-0 pb-1 text-[0.7rem] tracking-[0.3em] text-[var(--text-muted)]">
        {index}
      </span>
    )
  }
</div>
